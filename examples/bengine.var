fn blkind(i) {
    if (blocktag(i) == 7) {
        return 22;
    }
    return 0;
}

fn blkhide(i) {
    if (blocktag(i) == 7) {
        return 0;
    }
    return 1;
}

fn blkh(i) {
    let t = blocktag(i);
    let l = blocklen(i);
    let lines = l / 120 + 1;
    if (t > 0) {
        if (t < 7) {
            if (lines > 1) {
                return lines * 18 + 12;
            }
            return 32;
        }
        if (t == 8) {
            return lines * 16 + 14;
        }
        if (t == 10) {
            return 22;
        }
    }
    let h = lines * 17 + 14;
    if (h < 28) {
        h = 28;
    }
    return h;
}

fn blkcol(i) {
    let t = blocktag(i);
    let c = cssfg();
    if (c == 0) {
        c = #222222;
    }
    if (t > 0) {
        if (t < 7) {
            if (c > 8388607) {
                return #FFFFFF;
            }
            return #000000;
        }
        if (t == 8) {
            return #3C7A3C;
        }
    }
    return c;
}

