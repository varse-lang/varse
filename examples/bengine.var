fn main() {
    window "Varse Browser" 1084 782 bg=#17171B;

    input address 20 20 700 40 "https://example.com" radius=8 color=#26262B;
    button go 732 20 110 40 "Go" radius=8 color=#2864C7;
    button q1 854 20 100 40 "Wikipedia" radius=8 color=#33333A;
    button q2 964 20 100 40 "IANA" radius=8 color=#33333A;

    panel page 20 76 1044 636 radius=6 color=#FFFFFF;
    label title 40 98 1004 34 "" color=#111111;
    label status 20 722 1044 24 "" color=#8A8A93;
    label stats 20 748 1044 22 "" color=#5A5A63;

    onclick go {
        render();
    };

    onclick q1 {
        settext address "https://en.wikipedia.org/wiki/Assembly_language";
        render();
    };

    onclick q2 {
        settext address "https://www.iana.org/help/example-domains";
        render();
    };

    render();
    show;
}
