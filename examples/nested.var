def base: 10;

fn main() {
    fn add(x + y) {
        return x + y;
    }

    fn sub(x + y) {
        return x - y;
    }

    fn mul(x + y) {
        return x * y;
    }

    let sum = add(40 + 2);
    let diff = sub(sum + 12);
    let product = mul(diff + 2);

    print(sum);
    print(diff);
    print(product);
}
