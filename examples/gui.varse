fn main() {
    window "Varse GUI Demo" 600 400 bg=#222222;

    label lbl1 20 20 300 40 "Hello from Varse!";
    label lbl2 20 70 400 40 "Click a button below";

    button btn1 20 130 180 50 "red button" radius=10 color=#ff0000;
    button btn2 220 130 180 50 "green button" radius=10 color=#00ff00;
    button btn3 20 200 180 50 "blue pill button" radius=25 color=#0000ff;

    onclick btn1 {
        print(42);
    };

    onclick btn2 {
        print(100);
    };

    onclick btn3 {
        print(999);
    };

    show;
}
